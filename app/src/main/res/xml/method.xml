<?xml version="1.0" encoding="utf-8"?>
<!--
    Subtipo pt-BR com dica de layout físico "Inglês (EUA), Internacional":
    no Android 14+ o sistema já seleciona esse layout para o teclado físico.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="br.com.gfservice.cedilha.MainActivity"
    android:supportsSwitchingToNextInputMethod="false">
    <subtype
        android:label="@string/subtipo"
        android:languageTag="pt-BR"
        android:imeSubtypeLocale="pt_BR"
        android:imeSubtypeMode="keyboard"
        android:physicalKeyboardHintLanguageTag="en-US"
        android:physicalKeyboardHintLayoutType="extended" />
</input-method>
